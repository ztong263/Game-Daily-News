OPENAI_API_KEY=
# Optional external publisher bearer token. Server-only; never NEXT_PUBLIC.
BRIEF_PUBLISH_TOKEN=
EDITORIAL_MODEL=gpt-6-astra
EDITORIAL_MODE=production
EDITORIAL_DISCOVERY_MODEL=gpt-5.4-mini
EDITORIAL_SHORTLIST_MODEL=gpt-5.4-mini
EDITORIAL_FINAL_MODEL=gpt-6-astra
# Production: 1-8 (default 6). Preview: 1-3 (default 2).
# Omit this override when switching modes to use each mode's default.
# EDITORIAL_MAX_TOOL_CALLS=6
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
TRANSLATION_MODEL=gpt-5.4-mini
QUESTION_SEARCH_MODEL=gpt-5.4-mini
BRIEF_TIMEZONE=Australia/Sydney
DATA_DIR=./data
# Local single-server MVP. Bind only to localhost until access controls are added.

# Cloud mode is opt-in locally; Vercel always requires cloud authentication.
STORAGE_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GAME_DAILY_OWNER_EMAIL=
# Exact browser origin, including port locally. Set to the deployed HTTPS origin on Vercel.
APP_ORIGIN=http://127.0.0.1:3000
